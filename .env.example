# 이 파일을 .env 로 복사해서 쓰세요:  cp .env.example .env
#
# 로컬 개발은 Supabase CLI(`supabase start`)를 사용합니다.
# 아래 SUPABASE_URL/KEY 는 로컬 CLI 의 표준 값이라 팀원 전원 동일합니다.
# (비밀값 아님 — 로컬 전용 데모 키) 그대로 복사해 쓰면 됩니다.

# 애플리케이션
PROJECT_NAME=mjufinder-be
DEBUG=True

# Google Cloud Vision OCR 인증
# 팀에서 전달받은 서비스 계정 JSON 파일을 각자 PC에 저장한 뒤,
# .env의 아래 값을 본인 PC에 저장한 JSON 파일의 절대 경로로 설정하세요.
# Windows에서도 경로 구분자는 /를 사용하면 됩니다.
# 예: GOOGLE_APPLICATION_CREDENTIALS=C:/Users/사용자명/credentials/google-vision.json
# 설정 변경 후 백엔드 서버를 재시작하세요.
# 인증 JSON 파일과 .env는 Git에 커밋하지 마세요.
GOOGLE_APPLICATION_CREDENTIALS=

# CORS (프론트엔드 주소, 쉼표로 여러 개 가능)
CORS_ORIGINS=http://localhost:3000

# Supabase — 로컬 CLI 기본값 (supabase start 출력과 동일)
#  운영/클라우드 사용 시 각자 프로젝트의 URL/service_role 키로 교체
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU
